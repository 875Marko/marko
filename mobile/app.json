{
  "expo": {
    "name": "Car Spotter",
    "slug": "car-spotter",
    "scheme": "carspotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0F1115",
    "splash": {
      "backgroundColor": "#0F1115"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carspotter.app"
    },
    "android": {
      "package": "com.carspotter.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api"
    }
  }
}
