# MongoDB connection string, e.g. from MongoDB Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=

# Database name to use on that cluster.
DB_NAME=car_spotter

# API key from https://console.anthropic.com/ — used by /api/scan to identify
# cars from photos. The account needs credits/billing enabled.
ANTHROPIC_API_KEY=
